---
import { cn } from '@/lib/utils'

const { class: classValue, className, ...attrs } = Astro.props
---

<div
  class={cn(
    'relative overflow-y-auto outline-ring/50 transition-[color,box-shadow] focus-visible:outline-1 focus-visible:ring-4 focus-visible:ring-ring/10 dark:outline-ring/40 dark:focus-visible:ring-ring/20',
    className,
    classValue,
  )}
  data-scroll-viewport
  {...attrs}
>
  <slot />
</div>
