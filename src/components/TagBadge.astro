---
import { badgeVariants } from '@/components/ui/badge'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

interface Props {
  tag: string
  compact?: boolean
}

const { tag, compact = false } = Astro.props
---

<a
  href={`/tags/${tag}`}
  class={cn(
    badgeVariants({ variant: 'muted' }),
    'text-muted-foreground hover:border-border hover:bg-muted/60 hover:text-foreground cursor-pointer border-transparent bg-transparent transition-colors duration-150',
    compact && 'px-1.5 py-0 text-[11px] leading-5',
  )}
>
  <Icon name="lucide:hash" class="size-3 opacity-60" />
  {tag}
</a>
