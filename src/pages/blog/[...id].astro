---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Giscus from '@/components/Giscus.astro'
import Icon from '@/components/Icon.astro'
import Link from '@/components/Link.astro'
import PostHead from '@/components/PostHead.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import SeriesReader from '@/components/SeriesReader.astro'
import TagBadge from '@/components/TagBadge.astro'
import TOCHeader from '@/components/TOCHeader.astro'
import TOCSidebar from '@/components/TOCSidebar.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import {
  getAllPosts,
  getCombinedReadingTime,
  getPostChains,
  getPostReadingTime,
  getSubpostAnchor,
  getSubpostCount,
  getTOCSections,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { getDisplayCoverImage } from '@/lib/post-images'
import { calculateWordCountFromHtml, cn, formatDate } from '@/lib/utils'
import { buttonVariants } from '@/lib/variants'
import { Image } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'

type Props = {
  post: CollectionEntry<'blog'>
  chain: CollectionEntry<'blog'>[]
  newerPost?: CollectionEntry<'blog'>
  olderPost?: CollectionEntry<'blog'>
}

export async function getStaticPaths() {
  const posts = await getAllPosts()
  const chains = await getPostChains()

  return posts.flatMap((parent, index) => {
    const chain = chains.get(parent.id) ?? [parent]

    return chain.map((post) => ({
      params: { id: post.id },
      props: {
        post,
        chain,
        newerPost: posts[index - 1],
        olderPost: posts[index + 1],
      },
    }))
  })
}

const { post, chain, newerPost, olderPost } = Astro.props
const parentPost = chain[0]
const currentPostId = post.id
const isCurrentSubpost = isSubpost(currentPostId)
const canonical = isCurrentSubpost ? `/blog/${parentPost.id}` : undefined
const shouldSkipParentContent =
  chain.length > 1 && calculateWordCountFromHtml(parentPost.body) === 0
const displayChain = shouldSkipParentContent ? chain.slice(1) : chain

const renderedPosts = await Promise.all(
  displayChain.map(async (entry, index) => {
    const isParentEntry = entry.id === parentPost.id
    const { Content } = await render(entry)
    const anchor = isParentEntry ? undefined : getSubpostAnchor(entry.id)
    const readingTime = await getPostReadingTime(entry.id)
    const hasBody = calculateWordCountFromHtml(entry.body) > 0
    const combinedReadingTime =
      isParentEntry && chain.length > 1
        ? await getCombinedReadingTime(entry.id)
        : null

    return {
      entry,
      Content,
      anchor,
      isParentEntry,
      authors: await parseAuthors(entry.data.authors),
      coverImage: getDisplayCoverImage(entry),
      readingTime,
      hasBody,
      combinedReadingTime,
      subpostCount: index === 0 ? await getSubpostCount(entry.id) : 0,
    }
  }),
)

const tocSections = await getTOCSections(parentPost.id)
const hasToc = tocSections.length > 0
---

<Layout pagefind>
  <PostHead slot="head" post={post} canonical={canonical} />

  {hasToc && <TOCHeader slot="table-of-contents" sections={tocSections} />}

  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--breakpoint-md)-2rem),100%)_minmax(0px,1fr)] gap-y-8"
  >
    <div class="col-start-2">
      <Breadcrumbs
        items={[
          { href: '/blog', label: '文章', icon: 'library-big' },
          ...(isCurrentSubpost
            ? [
                {
                  href: `/blog/${parentPost.id}`,
                  label: parentPost.data.title,
                  icon: 'book-open',
                },
                {
                  href: `/blog/${currentPostId}`,
                  label: post.data.title,
                  icon: 'file-text',
                },
              ]
            : [
                {
                  href: `/blog/${currentPostId}`,
                  label: post.data.title,
                  icon: 'book-open-text',
                },
              ]),
        ]}
      />
    </div>

    {
      hasToc && (
        <TOCSidebar sections={tocSections} currentPostId={currentPostId} />
      )
    }

    {
      renderedPosts.map(
        (
          {
            entry,
            Content,
            anchor,
            isParentEntry,
            authors,
            coverImage,
            readingTime,
            hasBody,
            combinedReadingTime,
            subpostCount,
          },
          index,
        ) => {
          const isPageHeading =
            entry.id === post.id ||
            (shouldSkipParentContent && !isCurrentSubpost && index === 0)
          const articleUrl =
            shouldSkipParentContent && !isCurrentSubpost && index === 0
              ? `/blog/${parentPost.id}`
              : `/blog/${entry.id}`

          return (
            <article
              id={anchor ?? 'post-title'}
              class={cn(
                'col-start-2 flex scroll-mt-31 flex-col gap-y-6',
                index > 0 && 'border-t pt-10',
              )}
              data-url={articleUrl}
              data-title={`${entry.data.title} | ${SITE.title}`}
              data-anchor={anchor}
              data-embedded={!isParentEntry ? 'true' : undefined}
            >
              {coverImage && (
                <div class="border-border/60 bg-muted/20 mx-auto w-full max-w-3xl overflow-hidden rounded-md border">
                  <Image
                    src={coverImage}
                    alt={entry.data.title}
                    width={1200}
                    height={630}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class="aspect-[1200/630] w-full object-contain"
                  />
                </div>
              )}

              <header class="flex flex-col gap-y-6 text-center">
                <div class="flex flex-col">
                  <h1
                    class={cn(
                      'mb-3 scroll-mt-31 leading-tight font-medium',
                      index === 0
                        ? 'text-3xl sm:text-4xl'
                        : 'text-2xl sm:text-3xl',
                    )}
                    data-pagefind-meta={isPageHeading ? 'title' : undefined}
                  >
                    {entry.data.title}
                  </h1>
                  <time
                    class="sr-only"
                    datetime={entry.data.date.toISOString()}
                    data-pagefind-meta={isPageHeading ? 'date' : undefined}
                  >
                    {entry.data.date.toISOString()}
                  </time>

                  <div class="text-muted-foreground mb-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm">
                    <div class="flex items-center gap-x-2">
                      {authors.map((author) => (
                        <div class="flex items-center gap-x-1.5">
                          <img
                            src={author.avatar}
                            alt={author.name}
                            width="20"
                            height="20"
                            class="rounded-full"
                            loading="lazy"
                          />
                          <Link
                            href={`/authors/${author.id}`}
                            underline
                            class="text-foreground"
                          >
                            <span>{author.name}</span>
                          </Link>
                        </div>
                      ))}
                    </div>

                    <div class="flex items-center gap-2">
                      <span>{formatDate(entry.data.date)}</span>
                    </div>

                    <div class="flex items-center gap-2">
                      {hasBody || !combinedReadingTime ? (
                        <span>
                          {readingTime}
                          {combinedReadingTime &&
                            combinedReadingTime !== readingTime && (
                              <span class="text-muted-foreground">
                                {' '}
                                ({combinedReadingTime} total)
                              </span>
                            )}
                        </span>
                      ) : (
                        <span>{combinedReadingTime} total</span>
                      )}
                    </div>

                    {subpostCount > 0 && (
                      <div class="flex items-center gap-1">
                        <Icon name="file-text" class="size-3" />
                        {subpostCount} 篇子文章
                      </div>
                    )}
                  </div>
                  <div class="flex flex-wrap justify-center gap-x-3 gap-y-1">
                    {entry.data.tags?.map((tag) => (
                      <TagBadge tag={tag} />
                    ))}
                  </div>
                </div>
              </header>

              <section class="flex flex-col gap-y-6">
                <div class="prose max-w-none" data-pagefind-body>
                  <Content />
                </div>
              </section>
            </article>
          )
        },
      )
    }

    <section class="col-start-2 flex flex-col gap-y-6 pt-4">
      <PostNavigation newerPost={newerPost} olderPost={olderPost} />
    </section>

    <section class="col-start-2 flex flex-col gap-y-6 pt-4">
      <Giscus />
    </section>
  </section>

  {chain.length > 1 && <SeriesReader />}

  <button
    class={buttonVariants({
      variant: 'outline',
      size: 'icon',
      class: 'group fixed right-8 bottom-8 z-50 hidden',
    })}
    id="scroll-to-top"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <Icon
      name="arrow-up"
      class="mx-auto size-4 transition-all group-hover:-translate-y-0.5"
    />
  </button>

  <script>
    document.addEventListener('astro:page-load', () => {
      const scrollToTopButton = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')

      if (scrollToTopButton && footer) {
        scrollToTopButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })

        window.addEventListener('scroll', () => {
          const footerRect = footer.getBoundingClientRect()
          const isFooterVisible = footerRect.top <= window.innerHeight

          scrollToTopButton.classList.toggle(
            'hidden',
            window.scrollY <= 300 || isFooterVisible,
          )
        })
      }

      // 清理连续脚注之间的逗号等分隔符
      document
        .querySelectorAll('sup:has(> a[data-footnote-ref])')
        .forEach((sup) => {
          let node = sup.nextSibling
          while (node) {
            if (node.nodeType === Node.TEXT_NODE) {
              // 移除仅包含逗号/顿号/空格等分隔符的文本节点
              const trimmed =
                node.textContent?.replace(/[\s,，、;；]+/g, '') ?? ''
              if (trimmed === '') {
                // 下一个有意义的元素是 sup 脚注时才移除
                const nextEl = sup.nextElementSibling
                if (
                  nextEl?.tagName === 'SUP' &&
                  nextEl.querySelector('a[data-footnote-ref]')
                ) {
                  node.remove()
                }
              }
              break
            } else {
              break
            }
          }
        })

      // 脚注 tooltip：提取底部脚注内容，写入行内引用的 data-tooltip
      document.querySelectorAll('a[data-footnote-ref]').forEach((ref) => {
        const href = ref.getAttribute('href')
        if (!href) return
        const targetId = href.replace('#', '')
        const footnoteLi = document.getElementById(targetId)
        if (!footnoteLi) return

        // 克隆节点，移除回退链接后取纯文本
        const clone = footnoteLi.cloneNode(true) as HTMLElement
        clone
          .querySelectorAll('a[data-footnote-backref]')
          .forEach((el) => el.remove())
        const text = clone.textContent?.trim().replace(/\s+/g, ' ') ?? ''
        if (text) {
          // 限制 tooltip 长度，过长时截断
          ref.setAttribute(
            'data-tooltip',
            text.length > 150 ? text.slice(0, 147) + '…' : text,
          )
        }
      })
    })
  </script>
</Layout>
